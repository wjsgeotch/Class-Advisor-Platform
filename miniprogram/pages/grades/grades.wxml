<view class="container">
  <view class="card">
    <view class="row" style="margin-bottom:16rpx">
      <picker wx:if="{{exams.length}}" bindchange="onExamChange" value="{{examIdx}}" range="{{exams}}" range-key="name">
        <view class="pill">{{exams.length?exams[examIdx].name:'请选择考试'}} ▾</view>
      </picker>
      <view wx:else class="muted">暂无考试</view>
      <view class="btn sm" bindtap="addExam">+ 考试</view>
    </view>

    <block wx:if="{{detail}}">
      <view class="row" style="margin:10rpx 0">
        <text class="muted">{{detail.exam.exam_date||''}}</text>
        <view class="btn sm danger" bindtap="delExam">删除考试</view>
      </view>
      <view class="grid2" style="margin-bottom:16rpx">
        <view class="stat"><view class="num">{{detail.stat.count}}</view><view class="label">参考</view></view>
        <view class="stat"><view class="num">{{detail.stat.avg}}</view><view class="label">平均</view></view>
        <view class="stat"><view class="num" style="color:#21a366">{{detail.stat.max}}</view><view class="label">最高</view></view>
        <view class="stat"><view class="num" style="color:#e23b3b">{{detail.stat.min}}</view><view class="label">最低</view></view>
      </view>

      <view class="row" style="margin-bottom:12rpx">
        <text class="muted">填写分数后点击保存</text>
        <view class="btn sm" bindtap="saveGrades">💾 保存</view>
      </view>
      <view wx:for="{{students}}" wx:key="id" class="list-item">
        <view><text style="font-weight:600">{{item.name}}</text><text class="muted" style="margin-left:10rpx">{{item.student_no}}</text></view>
        <input type="digit" data-sid="{{item.id}}" bindinput="onScore" value="{{scoreMap[item.id]}}" placeholder="分" style="width:140rpx;text-align:right;border:1rpx solid #e6e9f2;border-radius:10rpx;padding:10rpx" />
      </view>
    </block>
    <view wx:else class="empty">请选择或新增考试</view>
  </view>
</view>
