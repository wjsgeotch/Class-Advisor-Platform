/* 全局样式 */
page {
  background: #f4f6fb;
  color: #1f2740;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 28rpx;
}
.container { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(40,50,90,.05);
}
.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.muted { color: #7a86a6; font-size: 24rpx; }
.btn {
  background: #4f6df5; color: #fff; border-radius: 12rpx; padding: 16rpx 24rpx;
  font-size: 26rpx; text-align: center; border: none;
}
.btn.ghost { background: #eef1fa; color: #4f6df5; }
.btn.danger { background: #fdeaea; color: #e23b3b; }
.btn.sm { padding: 8rpx 16rpx; font-size: 22rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.stat { text-align: center; }
.stat .num { font-size: 48rpx; font-weight: 700; }
.stat .label { color: #7a86a6; font-size: 24rpx; margin-top: 6rpx; }
.tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 20rpx; font-size: 22rpx; }
.tag.blue { background: #eef1fa; color: #4f6df5; }
.tag.green { background: #e8f6ee; color: #21a366; }
.tag.red { background: #fdeaea; color: #e23b3b; }
.tag.amber { background: #fff3e0; color: #f5a623; }
.list-item {
  background: #fff; border-radius: 14rpx; padding: 24rpx; margin-bottom: 18rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.tab {
  padding: 12rpx 24rpx; border-radius: 30rpx; background: #fff; color: #7a86a6;
  font-size: 26rpx; border: 1rpx solid #e6e9f2;
}
.tab.active { background: #4f6df5; color: #fff; border-color: #4f6df5; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 16rpx 12rpx; border-bottom: 1rpx solid #eef1f7; font-size: 24rpx; text-align: left; }
th { color: #7a86a6; font-size: 22rpx; }
.field { margin-bottom: 18rpx; }
.field label { display: block; color: #7a86a6; font-size: 24rpx; margin-bottom: 8rpx; }
.field input, .field picker {
  border: 1rpx solid #e6e9f2; border-radius: 10rpx; padding: 16rpx; font-size: 28rpx;
}
.empty { text-align: center; color: #7a86a6; padding: 60rpx; }
.pill { display: inline-block; padding: 4rpx 16rpx; border-radius: 10rpx; background: #eef1fa; color: #4f6df5; font-weight: 600; }
